#!/usr/bin/env bash
# Quality gate runner — reads .dev/stack.yml, executes gates (bash orchestration).
#
# Usage:
#   scripts/qg run --stage pre-commit
#   scripts/qg run --stage pre-push
#   scripts/qg run --stage ci
#   scripts/qg run --profile local
#   scripts/qg run [--stage STAGE] GATE_NAME
#   scripts/qg plan --stage ci [--format json|github] [--output PATH]
#
# Requires: yq (https://github.com/mikefarah/yq) — checked in tools/dev-setup.sh
#
# CI files: filtering — QG_DIFF_RANGE (optional, ci stage only):
#   Set by ci.yml on pull_request events to "origin/<base>...HEAD" (triple-dot
#   merge-base diff). When set AND the diff resolves, gates with a `files:`
#   regex are skipped unless a changed file matches. When unset (push to
#   staging/main, workflow_dispatch, future merge_group) or when the diff
#   fails (bad ref, shallow clone), the runner FAILS OPEN: all gates run.
set -euo pipefail

QG_SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="${QG_REPO_ROOT:-$(cd "${QG_SCRIPT_DIR}/.." && pwd)}"
STACK="${QG_STACK:-${REPO_ROOT}/.dev/stack.yml}"

# 1 only when a CI changed-files list was successfully computed (QG_DIFF_RANGE
# set AND git diff succeeded). Distinguishes "diff empty" (filter normally:
# nothing matches → filtered gates skip) from "diff unavailable" (fail open:
# run everything). Never fail-closed — a broken diff must not skip checks.
CI_FILTER_ACTIVE=0
QG_FAIL_OPEN=0
QG_TRIPWIRE_HIT=0
QG_TAXONOMY=()

# Gates invoke `uv run <tool>`; without no-sync, uv re-resolves and rewrites
# uv.lock / bakes worktree paths into the shared symlinked .venv when a gate
# runs from a linked worktree (git hooks fire there too). CI is unaffected:
# ci.yml runs `uv sync --frozen` before any gate.
export UV_NO_SYNC=1

BUN_HINT="bun not installed — https://bun.sh (see package.json packageManager)"
TRUFFLEHOG_HINT="trufflehog not installed — https://github.com/trufflesecurity/trufflehog/releases"

usage() {
  cat <<'EOF'
Usage:
  scripts/qg run --stage pre-commit|pre-push|ci
  scripts/qg run --profile NAME
  scripts/qg run [--stage STAGE] GATE_NAME
  scripts/qg plan --stage ci [--format json|github] [--output PATH]
EOF
}

require_yq() {
  if ! command -v yq >/dev/null 2>&1; then
    echo "::error::yq required — install via tools/dev-setup.sh or https://github.com/mikefarah/yq#install" >&2
    exit 2
  fi
}

yq_read() {
  yq -r "$1" "$STACK"
}

gate_field() {
  local gate="$1" field="$2"
  yq_read ".quality_gates[\"${gate}\"].${field}"
}

gate_enabled() {
  local gate="$1"
  local v
  v=$(gate_field "$gate" 'enabled // true')
  [[ "$v" != "false" ]]
}

gate_stages_list() {
  local gate="$1"
  local -a stages=()
  mapfile -t stages < <(yq_read ".quality_gates[\"${gate}\"].stages[]?" 2>/dev/null || true)
  if [[ ${#stages[@]} -eq 0 || -z "${stages[0]:-}" ]]; then
    local single
    single=$(gate_field "$gate" 'stage // "pre-commit"')
    printf '%s\n' "$single"
    return
  fi
  printf '%s\n' "${stages[@]}"
}

gate_has_stage() {
  local gate="$1" want="$2"
  local s
  while IFS= read -r s; do
    [[ -n "$s" && "$s" == "$want" ]] && return 0
  done < <(gate_stages_list "$gate")
  return 1
}

changed_files() {
  local stage="$1"
  local -a files=()
  # -z + NUL-delimited mapfile: default core.quotePath C-quotes non-ASCII
  # paths, which would never match a files: regex (same fix as the CI diff
  # in cmd_run). --diff-filter=ACMR is kept on the staged branch on purpose:
  # staged-file semantics deliberately diverge from the CI diff, where
  # deletions must trigger gates.
  if [[ "$stage" == "pre-push" && -n "${PRE_COMMIT_FROM_REF:-}" && -n "${PRE_COMMIT_TO_REF:-}" ]]; then
    mapfile -d '' -t files < <(git -C "$REPO_ROOT" diff --name-only -z "${PRE_COMMIT_FROM_REF}...${PRE_COMMIT_TO_REF}" 2>/dev/null || true)
  else
    mapfile -d '' -t files < <(git -C "$REPO_ROOT" diff --cached --name-only -z --diff-filter=ACMR 2>/dev/null || true)
  fi
  if [[ ${#files[@]} -eq 0 ]]; then
    return 0
  fi
  printf '%s\n' "${files[@]}"
}

files_match_pattern() {
  local pattern="$1"
  shift
  local f match_rc
  for f in "$@"; do
    [[ -n "$f" ]] || continue
    set +e
    [[ "$f" =~ $pattern ]]
    match_rc=$?
    set -e
    if [[ "$match_rc" -eq 2 ]]; then
      echo "::error::invalid files regex: ${pattern}" >&2
      return 2
    fi
    [[ "$match_rc" -eq 0 ]] && return 0
  done
  return 1
}

should_run_gate() {
  local gate="$1" stage="$2"
  shift 2
  local pattern
  pattern=$(gate_field "$gate" 'files // ""')
  if [[ -z "$pattern" ]]; then
    return 0
  fi
  # CI honors files: filters only when a changed-files list was successfully
  # computed (CI_FILTER_ACTIVE=1). Otherwise fail open — run the gate.
  # pre-commit/pre-push semantics are unchanged.
  if [[ "$stage" == "ci" && "$CI_FILTER_ACTIVE" -ne 1 ]]; then
    return 0
  fi
  if [[ $# -eq 0 ]]; then
    return 1
  fi
  files_match_pattern "$pattern" "$@"
}

# Populate CI_FILTER_ACTIVE and the changed-files array for the ci stage.
# Sets QG_FAIL_OPEN=1 when the diff range is absent or git diff failed.
load_ci_changed() {
  local -n _out_changed=$1
  CI_FILTER_ACTIVE=0
  QG_FAIL_OPEN=0
  _out_changed=()

  if [[ -z "${QG_DIFF_RANGE:-}" ]]; then
    QG_FAIL_OPEN=1
    return 0
  fi

  local difftmp errtmp git_err
  difftmp=$(mktemp)
  errtmp=$(mktemp)
  if git -C "$REPO_ROOT" diff --name-only -z --no-renames "$QG_DIFF_RANGE" >"$difftmp" 2>"$errtmp"; then
    CI_FILTER_ACTIVE=1
    mapfile -d '' -t _out_changed <"$difftmp"
  else
    git_err=$(tr '\n' ' ' <"$errtmp")
    echo "::warning::qg: git diff '${QG_DIFF_RANGE}' failed (${git_err:-no stderr}) — files: filters disabled, running ALL ci gates (fail-open)" >&2
    QG_FAIL_OPEN=1
  fi
  rm -f "$difftmp" "$errtmp"
}

change_class_names() {
  yq_read '.qg.change_classes | keys | .[]?' 2>/dev/null || true
}

change_class_pattern() {
  local class="$1"
  yq_read ".qg.change_classes[\"${class}\"].paths // \"\""
}

tripwire_patterns() {
  yq_read '.qg.tripwires[]?' 2>/dev/null || true
}

# Sets QG_TAXONOMY (sorted unique class names) and QG_TRIPWIRE_HIT (0|1).
classify_changed_files() {
  local -a changed=("$@")
  local -a taxonomy=()
  QG_TRIPWIRE_HIT=0

  local class pattern tw f match_rc
  while IFS= read -r class; do
    [[ -n "$class" ]] || continue
    pattern=$(change_class_pattern "$class")
    [[ -n "$pattern" && "$pattern" != "null" ]] || continue
    for f in "${changed[@]}"; do
      [[ -n "$f" ]] || continue
      set +e
      [[ "$f" =~ $pattern ]]
      match_rc=$?
      set -e
      if [[ "$match_rc" -eq 2 ]]; then
        echo "::error::invalid change_classes.${class} regex: ${pattern}" >&2
        return 2
      fi
      if [[ "$match_rc" -eq 0 ]]; then
        taxonomy+=("$class")
        break
      fi
    done
  done < <(change_class_names)

  if [[ ${#taxonomy[@]} -gt 0 ]]; then
    mapfile -t QG_TAXONOMY < <(printf '%s\n' "${taxonomy[@]}" | LC_ALL=C sort -u)
  else
    QG_TAXONOMY=()
  fi

  while IFS= read -r tw; do
    [[ -n "$tw" && "$tw" != "null" ]] || continue
    for f in "${changed[@]}"; do
      [[ -n "$f" ]] || continue
      set +e
      [[ "$f" =~ $tw ]]
      match_rc=$?
      set -e
      if [[ "$match_rc" -eq 2 ]]; then
        echo "::error::invalid tripwire regex: ${tw}" >&2
        return 2
      fi
      if [[ "$match_rc" -eq 0 ]]; then
        QG_TRIPWIRE_HIT=1
        return 0
      fi
    done
  done < <(tripwire_patterns)

  return 0
}

plan_gate_decision() {
  local gate="$1" stage="$2"
  shift 2
  local -a changed=("$@")

  if [[ "$gate" == "doc_drift_bundle" ]]; then
    if [[ "$QG_FAIL_OPEN" -eq 1 ]]; then
      printf '%s' "run|fail_open"
      return 0
    fi
    if [[ "$QG_TRIPWIRE_HIT" -eq 1 ]]; then
      printf '%s' "run|tripwire"
      return 0
    fi
    local c
    for c in "${QG_TAXONOMY[@]}"; do
      if [[ "$c" == "docs" ]]; then
        printf '%s' "run|taxonomy_docs"
        return 0
      fi
    done
    printf '%s' "run|always_on"
    return 0
  fi

  if ! gate_enabled "$gate"; then
    printf '%s' "skip|disabled"
    return 0
  fi

  if [[ -n "$stage" ]] && ! gate_has_stage "$gate" "$stage"; then
    printf '%s' "skip|not_in_stage"
    return 0
  fi

  if [[ "$QG_FAIL_OPEN" -eq 1 ]]; then
    printf '%s' "run|fail_open"
    return 0
  fi

  if [[ "$QG_TRIPWIRE_HIT" -eq 1 ]]; then
    printf '%s' "run|tripwire"
    return 0
  fi

  local pattern
  pattern=$(gate_field "$gate" 'files // ""')
  if [[ -z "$pattern" || "$pattern" == "null" ]]; then
    printf '%s' "run|no_files_filter"
    return 0
  fi

  if [[ "$CI_FILTER_ACTIVE" -ne 1 ]]; then
    printf '%s' "run|fail_open"
    return 0
  fi

  if [[ ${#changed[@]} -eq 0 ]]; then
    printf '%s' "skip|no_matching_files"
    return 0
  fi

  local run_decision=0
  should_run_gate "$gate" "$stage" "${changed[@]}"
  run_decision=$?
  if [[ "$run_decision" -eq 2 ]]; then
    return 2
  fi
  if [[ "$run_decision" -eq 0 ]]; then
    printf '%s' "run|matching_files"
  else
    printf '%s' "skip|no_matching_files"
  fi
}

default_script() {
  case "$1" in
    file_length) echo "bash tools/check_file_length.sh" ;;
    folder_size) echo "bash tools/check_folder_size.sh" ;;
    import_layers) echo "uv run lint-imports" ;;
    *) return 1 ;;
  esac
}

resolve_command() {
  local gate="$1" stage="$2"
  local cmd=""
  if [[ "$stage" == "ci" ]]; then
    cmd=$(gate_field "$gate" 'ci_script // ""')
  fi
  if [[ -z "$cmd" || "$cmd" == "null" ]]; then
    cmd=$(gate_field "$gate" 'script // ""')
  fi
  if [[ -z "$cmd" || "$cmd" == "null" ]]; then
    cmd=$(default_script "$gate" || true)
  fi
  if [[ -z "$cmd" ]]; then
    echo "::error::gate ${gate} has no script" >&2
    return 2
  fi
  printf '%s' "$cmd"
}

require_binary() {
  local name="$1" hint="$2"
  if ! command -v "$name" >/dev/null 2>&1; then
    echo "::error::${hint}" >&2
    return 2
  fi
  return 0
}

check_requires() {
  local gate="$1"
  local req
  req=$(gate_field "$gate" 'requires // ""')
  case "$req" in
    bun) require_binary bun "$BUN_HINT" ;;
    trufflehog) require_binary trufflehog "$TRUFFLEHOG_HINT" ;;
    "") return 0 ;;
    *)
      echo "::error::unknown requires=${req} on gate ${gate}" >&2
      return 2
      ;;
  esac
}

run_shell_cmd() {
  local gate="$1" cmd="$2"
  echo "==> ${gate}"
  bash -euo pipefail -c "$cmd"
}

apply_gate_env() {
  local gate="$1"
  local -a keys=()
  mapfile -t keys < <(yq_read ".quality_gates[\"${gate}\"].env | keys | .[]?" 2>/dev/null || true)
  local k v
  for k in "${keys[@]}"; do
    [[ -n "$k" ]] || continue
    if [[ ! "$k" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
      echo "::error::invalid env key ${k} on gate ${gate}" >&2
      return 2
    fi
    v=$(gate_field "$gate" "env[\"${k}\"]")
    export "${k}=${v}"
  done
}

run_doc_drift_bundle() {
  local doc sem agents_adr
  doc=$(gate_field "doc_drift" 'script // "tools/check_doc_drift.py"')
  sem=$(gate_field "doc_semantic_drift" 'script // "tools/check_doc_semantic_drift.py"')
  agents_adr=$(gate_field "agents_no_adr_refs" 'script // "tools/check_agents_no_adr_refs.sh"')
  local cmd
  cmd=$(cat <<EOF
set -euo pipefail
if find docs/ -name "*.md" ! -path "*/architecture/*" -print0 | xargs -0 grep -n "FACTORY_LOG_DIR\\|json_file\\s*=\\|RotatingFileHandler"; then
  echo "::error::Removed symbols in operator docs — update docs to match code"
  exit 1
fi
uv run python ${doc}
uv run python ${sem}
bash ${agents_adr}
EOF
)
  run_shell_cmd "doc_drift_bundle" "$cmd"
}

run_gate() {
  local gate="$1" stage_filter="${2:-}"
  shift 2 || true
  local -a changed=("$@")

  if [[ "$gate" == "doc_drift_bundle" ]]; then
    # Deliberate short-circuit BEFORE the enabled/stage/files checks below —
    # the bundle composes doc_drift + doc_semantic_drift itself. A `files:`
    # entry on doc_drift_bundle would be dead config: it always runs.
    run_doc_drift_bundle
    return $?
  fi

  gate_enabled "$gate" || return 0

  if [[ -n "$stage_filter" ]] && ! gate_has_stage "$gate" "$stage_filter"; then
    return 0
  fi

  local run_decision=0
  should_run_gate "$gate" "${stage_filter:-ci}" "${changed[@]}"
  run_decision=$?
  if [[ "$run_decision" -eq 2 ]]; then
    return 2
  fi
  if [[ "$run_decision" -ne 0 ]]; then
    echo "==> ${gate} (skipped — no matching files)"
    return 0
  fi

  check_requires "$gate" || return $?

  local cmd
  cmd=$(resolve_command "$gate" "${stage_filter:-ci}") || return $?

  (
    cd "$REPO_ROOT"
    apply_gate_env "$gate"
    run_shell_cmd "$gate" "$cmd"
  )
}

ordered_gates() {
  local mode="$1" key="$2"
  local -a names=()
  if [[ "$mode" == "profile" ]]; then
    mapfile -t names < <(yq_read ".qg.profiles[\"${key}\"][]?" 2>/dev/null || true)
    if [[ ${#names[@]} -eq 0 || -z "${names[0]:-}" ]]; then
      echo "::error::unknown profile ${key}" >&2
      return 2
    fi
  else
    mapfile -t names < <(yq_read ".qg.run_order[\"${key}\"][]?" 2>/dev/null || true)
    if [[ ${#names[@]} -eq 0 || -z "${names[0]:-}" ]]; then
      echo "::error::no run_order for stage ${key}" >&2
      return 2
    fi
  fi
  local n
  for n in "${names[@]}"; do
    gate_enabled "$n" && printf '%s\n' "$n"
  done
}

cmd_run() {
  local stage="" profile="" gate_name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stage)
        stage="$2"
        shift 2
        ;;
      --profile)
        profile="$2"
        shift 2
        ;;
      -h|--help)
        usage
        return 0
        ;;
      run)
        shift
        ;;
      -*)
        echo "::error::unknown option $1" >&2
        usage >&2
        return 2
        ;;
      *)
        gate_name="$1"
        shift
        ;;
    esac
  done

  require_yq
  [[ -f "$STACK" ]] || { echo "::error::missing ${STACK}" >&2; return 2; }

  local -a names=()
  local stage_filter=""
  local -a changed=()

  if [[ -n "$gate_name" ]]; then
    names=("$gate_name")
    stage_filter="$stage"
  elif [[ -n "$profile" ]]; then
    mapfile -t names < <(ordered_gates profile "$profile") || return $?
    stage_filter=""
  elif [[ -n "$stage" ]]; then
    mapfile -t names < <(ordered_gates stage "$stage") || return $?
    stage_filter="$stage"
    if [[ "$stage" == "pre-commit" || "$stage" == "pre-push" ]]; then
      mapfile -t changed < <(changed_files "$stage")
    fi
  else
    echo "::error::specify --stage, --profile, or a gate name" >&2
    return 2
  fi

  if [[ "$stage" == "ci" ]]; then
    load_ci_changed changed
  fi

  local failed=0 rc=0 n
  for n in "${names[@]}"; do
    [[ -n "$n" ]] || continue
    rc=0
    if [[ ${#changed[@]} -gt 0 ]]; then
      run_gate "$n" "$stage_filter" "${changed[@]}" || rc=$?
    else
      run_gate "$n" "$stage_filter" || rc=$?
    fi
    if [[ "$rc" -ne 0 ]]; then
      echo "::error::gate ${n} failed (exit ${rc})" >&2
      failed=1
    fi
  done
  return "$failed"
}

cmd_plan() {
  local stage="" format="json" output_path=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --stage)
        stage="$2"
        shift 2
        ;;
      --format)
        format="$2"
        shift 2
        ;;
      --output)
        output_path="$2"
        shift 2
        ;;
      -h|--help)
        usage
        return 0
        ;;
      plan)
        shift
        ;;
      -*)
        echo "::error::unknown option $1" >&2
        usage >&2
        return 2
        ;;
      *)
        echo "::error::unexpected argument $1" >&2
        return 2
        ;;
    esac
  done

  require_yq
  [[ -f "$STACK" ]] || { echo "::error::missing ${STACK}" >&2; return 2; }
  [[ "$stage" == "ci" ]] || { echo "::error::plan requires --stage ci" >&2; return 2; }
  case "$format" in
    json | github) ;;
    *)
      echo "::error::unknown format ${format}" >&2
      return 2
      ;;
  esac

  local -a changed=()
  local -a names=()
  QG_FAIL_OPEN=0
  QG_TRIPWIRE_HIT=0
  QG_TAXONOMY=()

  load_ci_changed changed
  classify_changed_files "${changed[@]}" || return $?

  mapfile -t names < <(ordered_gates stage "$stage") || return $?

  local -a gate_lines=()
  local n decision rc=0
  for n in "${names[@]}"; do
    [[ -n "$n" ]] || continue
    decision=$(plan_gate_decision "$n" "$stage" "${changed[@]}") || rc=$?
    if [[ "$rc" -eq 2 ]]; then
      return 2
    fi
    gate_lines+=("${n}|${decision}")
  done

  local -a changed_json=()
  local f
  for f in "${changed[@]}"; do
    [[ -n "$f" ]] || continue
    changed_json+=("$f")
  done

  local meta_json
  meta_json=$(
    QG_DIFF_RANGE="${QG_DIFF_RANGE:-}" \
    QG_STAGE="$stage" \
    QG_FORMAT="$format" \
    QG_OUTPUT="$output_path" \
    QG_FILTER_ACTIVE="$CI_FILTER_ACTIVE" \
    QG_FAIL_OPEN="$QG_FAIL_OPEN" \
    QG_TRIPWIRE_HIT="$QG_TRIPWIRE_HIT" \
    QG_TAXONOMY_JSON="$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "${QG_TAXONOMY[@]}")" \
    QG_CHANGED_JSON="$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "${changed_json[@]}")" \
    python3 - <<'PY'
import json, os
print(json.dumps({
    "stage": os.environ["QG_STAGE"],
    "format": os.environ["QG_FORMAT"],
    "output_path": os.environ.get("QG_OUTPUT") or "",
    "filter_active": os.environ.get("QG_FILTER_ACTIVE") == "1",
    "fail_open": os.environ.get("QG_FAIL_OPEN") == "1",
    "tripwire_hit": os.environ.get("QG_TRIPWIRE_HIT") == "1",
    "diff_range": os.environ.get("QG_DIFF_RANGE") or "",
    "changed_files": json.loads(os.environ.get("QG_CHANGED_JSON") or "[]"),
    "taxonomy": json.loads(os.environ.get("QG_TAXONOMY_JSON") or "[]"),
}))
PY
  )

  printf '%s\n' "${gate_lines[@]}" | python3 "${QG_SCRIPT_DIR}/qg_plan_emit.py" "$meta_json"
}

main() {
  case "${1:-}" in
    run) shift; cmd_run "$@" ;;
    plan) shift; cmd_plan "$@" ;;
    -h|--help|"") usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
