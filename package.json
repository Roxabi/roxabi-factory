{
  "name": "roxabi-factory",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev:dashboard": "bun --filter @roxabi-factory/dashboard-v2 dev",
    "build:dashboard": "bun --filter @roxabi-factory/dashboard-v2 build",
    "typecheck": "bun run --filter '@roxabi-factory/*' typecheck",
    "lint": "biome check apps packages brand",
    "format": "biome check --write apps packages brand"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0"
  }
}
